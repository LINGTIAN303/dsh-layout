{
  "name": "dsh-layout",
  "version": "0.9.1",
  "type": "module",
  "description": "布局：自定义 DSH 界面结构（左栏 / 右栏 / 会话区 / 设置页）",
  "license": "MIT",
  "author": "LINGTIAN303",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINGTIAN303/dsh-layout.git"
  },
  "homepage": "https://github.com/LINGTIAN303/dsh-layout#readme",
  "bugs": "https://github.com/LINGTIAN303/dsh-layout/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "layout",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.board.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
